{
  "name": "@maxcwolf/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook for wolf-ui: on-device (iOS, Android) through Expo, and on the web through react-native-web. Also the Expo and Expo web compatibility check.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "storybook dev -p 6006 --config-dir .storybook --no-open",
    "web:build": "storybook build --config-dir .storybook --output-dir storybook-static --quiet",
    "expo:web:export": "expo export --platform web --output-dir .expo/web-export",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@gorhom/bottom-sheet": "5.2.14",
    "@maxcwolf/ui-react-native": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@shopify/restyle": "2.4.5",
    "expo": "~58.0.23",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/assets-registry": "0.88.1",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-ondevice-actions": "10.7.1",
    "@storybook/addon-ondevice-controls": "10.7.1",
    "@storybook/react": "10.6.6",
    "@storybook/react-native": "10.7.1",
    "@storybook/react-native-web-vite": "10.6.6",
    "@types/react": "~19.3.0",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
