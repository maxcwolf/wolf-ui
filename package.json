{
  "name": "wolf-ui",
  "private": true,
  "description": "Themeable, type-safe React Native component library built on Restyle. Bare React Native, Expo and Expo web.",
  "license": "MIT",
  "author": "Max Wolf <maxcharleswolf@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxcwolf/wolf-ui.git"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn depcruise && yarn knip && yarn test && yarn build && yarn verify:packages",
    "typecheck": "yarn workspaces foreach --all --parallel --exclude wolf-ui run typecheck && tsc -p scripts",
    "lint": "eslint . --max-warnings 0 --cache",
    "lint:fix": "eslint . --max-warnings 0 --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages apps e2e scripts --validate .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "yarn workspaces foreach --all --parallel --exclude wolf-ui run test && yarn test:scripts",
    "test:scripts": "node --test --test-reporter=spec \"scripts/**/*.test.mjs\" \"eslint-rules/**/*.test.mjs\"",
    "build": "yarn workspaces foreach --all --topological --include '@maxcwolf/ui-*' run build",
    "verify:packages": "yarn workspaces foreach --all --include '@maxcwolf/ui-*' run verify",
    "new:component": "node scripts/new-component.mjs",
    "storybook:web": "yarn workspace @maxcwolf/storybook web",
    "storybook:ios": "yarn workspace @maxcwolf/storybook ios",
    "storybook:android": "yarn workspace @maxcwolf/storybook android",
    "e2e": "yarn workspace @maxcwolf/e2e e2e",
    "e2e:docker": "yarn workspace @maxcwolf/e2e e2e:docker",
    "e2e:update-screenshots": "yarn workspace @maxcwolf/e2e e2e:docker --update-snapshots",
    "changeset": "changeset",
    "release": "yarn build && changeset publish",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "globals": "17.14.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
