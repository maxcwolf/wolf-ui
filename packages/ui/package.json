{
  "name": "@maxcwolf/ui-react-native",
  "version": "2.0.0",
  "description": "Themeable, type-safe React Native components built on Restyle. Bare React Native, Expo and react-native-web.",
  "license": "MIT",
  "author": "Max Wolf <maxcharleswolf@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxcwolf/wolf-ui.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "restyle",
    "design-system",
    "component-library"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "wolf-ui-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.stories.tsx",
    "!src/test-utils",
    "!src/__contracts__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --coverage",
    "verify": "publint --strict"
  },
  "dependencies": {
    "@maxcwolf/ui-tokens": "workspace:^"
  },
  "peerDependencies": {
    "@shopify/restyle": "^2.4.5",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/jest-preset": "0.88.1",
    "@shopify/restyle": "2.4.5",
    "@storybook/react": "10.6.6",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "jest": "30.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "0.44.1",
    "react-native-svg": "15.16.0",
    "storybook": "10.6.6",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{*.test.ts,*.test.tsx,*.stories.tsx,test-utils/**,__contracts__/**}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
